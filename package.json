{
  "name": "ww",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter web --filter api dev",
    "web": "pnpm --filter web dev",
    "api": "pnpm --filter api dev",
    "build": "pnpm -r --filter web --filter api build",
    "start": "pnpm --filter api start",
    "lint": "pnpm typecheck",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/types/src/database.gen.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "supabase": "^2.122.0"
  }
}
  